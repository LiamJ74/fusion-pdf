<!--
  Fusion PDF - fenêtre principale.

  Chargée à l'exécution par XamlReader (pas de MSBuild, donc pas de x:Class) :
  les contrôles sont retrouvés par leur x:Name et les événements branchés dans
  Fenetre.cs. Aucun attribut d'événement ici.

  Palette : bleu Tailwind (primary 50 à 900),
  et les gris par défaut de Tailwind. Police : celle de Tailwind «&#160;sans&#160;» sous
  Windows, Segoe UI.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fusion PDF" Width="1160" Height="860" MinWidth="920" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="#F9FAFB"
        FontFamily="Segoe UI" FontSize="13" Foreground="#111827"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" AllowDrop="True">

  <Window.Resources>
    <!-- primary -->
    <SolidColorBrush x:Key="P50"  Color="#EFF6FF"/>
    <SolidColorBrush x:Key="P100" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="P200" Color="#BFDBFE"/>
    <SolidColorBrush x:Key="P300" Color="#93C5FD"/>
    <SolidColorBrush x:Key="P400" Color="#60A5FA"/>
    <SolidColorBrush x:Key="P500" Color="#2563EB"/>
    <SolidColorBrush x:Key="P600" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="P700" Color="#1E40AF"/>
    <SolidColorBrush x:Key="P800" Color="#1E3A8A"/>
    <SolidColorBrush x:Key="P900" Color="#1E3A5F"/>
    <!-- gris Tailwind -->
    <SolidColorBrush x:Key="G50"  Color="#F9FAFB"/>
    <SolidColorBrush x:Key="G100" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="G200" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="G300" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="G400" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="G500" Color="#6B7280"/>
    <SolidColorBrush x:Key="G600" Color="#4B5563"/>
    <SolidColorBrush x:Key="G700" Color="#374151"/>
    <SolidColorBrush x:Key="G900" Color="#111827"/>

    <FontFamily x:Key="Icones">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Ico" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Icones}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Bouton secondaire : blanc, bordure grise, coins arrondis -->
    <Style x:Key="BtnSec" TargetType="Button">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="{StaticResource G700}"/>
      <Setter Property="BorderBrush" Value="{StaticResource G300}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#F9FAFB"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#9CA3AF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#F3F4F6"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#2563EB"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Bouton contour primaire (zone de dépôt) -->
    <Style x:Key="BtnContour" TargetType="Button" BasedOn="{StaticResource BtnSec}">
      <Setter Property="Foreground" Value="{StaticResource P600}"/>
      <Setter Property="BorderBrush" Value="{StaticResource P300}"/>
    </Style>

    <!-- Bouton primaire : #2563eb, survol #1d4ed8 -->
    <Style x:Key="BtnPrim" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource P500}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1D4ED8"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1E40AF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="#93C5FD"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Segment du sélecteur de langue ; le segment actif est coloré par le code -->
    <Style x:Key="BtnLangue" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource G500}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5" Padding="9,4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#F3F4F6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Bouton discret (fermer un bandeau) -->
    <Style x:Key="BtnDiscret" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource G500}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Width="28" Height="28">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#14000000"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Champ de saisie -->
    <Style x:Key="Champ" TargetType="TextBox">
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="BorderBrush" Value="{StaticResource G300}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="{StaticResource G900}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#2563EB"/>
                <Setter TargetName="b" Property="BorderThickness" Value="1.5"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Hyperlink">
      <Setter Property="Foreground" Value="{StaticResource P600}"/>
      <Setter Property="TextDecorations" Value="{x:Null}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="TextDecorations" Value="Underline"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#111827"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Barre de progression fine -->
    <Style x:Key="Barre" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" Background="#DBEAFE" CornerRadius="3"/>
              <Border x:Name="PART_Indicator" Background="#2563EB" CornerRadius="3" HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Ligne de la liste -->
    <Style x:Key="Ligne" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="ToolTip" Value="{Binding InfoBulle}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="fond" Background="Transparent" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                <Grid>
                  <Border x:Name="barre" Width="3" HorizontalAlignment="Left" Background="Transparent"/>
                  <ContentPresenter/>
                </Grid>
              </Border>
              <Border Height="2" VerticalAlignment="Top" Background="#2563EB" Visibility="{Binding VisLigneAvant}"/>
              <Border Height="2" VerticalAlignment="Bottom" Background="#2563EB" Visibility="{Binding VisLigneApres}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="fond" Property="Background" Value="#F9FAFB"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="fond" Property="Background" Value="#EFF6FF"/>
                <Setter TargetName="barre" Property="Background" Value="#2563EB"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="ModeleLigne">
      <Grid Height="48" Margin="14,0,16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="34"/>
          <ColumnDefinition Width="30"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="84"/>
          <ColumnDefinition Width="72"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding TexteRang}" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Style="{StaticResource Ico}" FontSize="18" Text="&#xE8A5;" Foreground="{Binding CouleurIcone}"/>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0,8,0">
          <TextBlock Text="{Binding Nom}" TextTrimming="CharacterEllipsis" Foreground="#111827" FontWeight="SemiBold" FontSize="13"/>
          <TextBlock Text="{Binding SousTitre}" TextTrimming="CharacterEllipsis" Foreground="#6B7280" FontSize="11.5" Margin="0,1,0,0"/>
        </StackPanel>
        <Border Grid.Column="3" Visibility="{Binding VisBadge}" Background="{Binding FondBadge}" BorderBrush="{Binding BordBadge}"
                BorderThickness="1" CornerRadius="10" Padding="8,2,9,2" Margin="0,0,8,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Ico}" FontSize="11" Text="{Binding IconeBadge}" Foreground="{Binding EncreBadge}"/>
            <TextBlock Text="{Binding TexteBadge}" FontSize="11.5" Margin="5,0,0,1" Foreground="{Binding EncreBadge}" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
        <TextBlock Grid.Column="4" Text="{Binding TextePages}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#374151"/>
        <TextBlock Grid.Column="5" Text="{Binding TexteTaille}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#6B7280"/>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============ En-tête ============ -->
    <Border Background="White" BorderBrush="{StaticResource G200}" BorderThickness="0,0,0,1" Padding="24,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Image x:Name="ImgLogo" Height="34" Width="34" Margin="0,0,14,0" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Fusion PDF" FontSize="19" FontWeight="Bold" Foreground="{StaticResource G900}"/>
          <TextBlock Text="§Assemblez plusieurs PDF en un seul fichier, dans l'ordre de votre choix.§" Foreground="{StaticResource G500}" FontSize="12.5"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="PastilleQpdf" CornerRadius="12" BorderThickness="1" Padding="10,4" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="PointQpdf" Width="7" Height="7" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtQpdf" Margin="7,0,0,1" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <!-- Sélecteur de langue : FR | EN. Les noms de langue ne se traduisent pas. -->
          <Border CornerRadius="7" BorderBrush="{StaticResource G300}" BorderThickness="1" Background="White" Margin="12,0,0,0" Padding="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnFr" Style="{StaticResource BtnLangue}" Content="FR" ToolTip="Français"/>
              <Button x:Name="BtnEn" Style="{StaticResource BtnLangue}" Content="EN" ToolTip="English" Margin="2,0,0,0"/>
            </StackPanel>
          </Border>
          <Button x:Name="BtnAide" Style="{StaticResource BtnSec}" Margin="8,0,0,0" Padding="12,6" ToolTip="§Mode d'emploi (F1)§">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Ico}" Text="&#xE897;"/><TextBlock Text="§Aide§" Margin="6,0,0,0"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ Contenu ============ -->
    <Grid Grid.Row="1" Margin="24,18,24,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="320"/>
      </Grid.ColumnDefinitions>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Zone de dépôt -->
        <Grid x:Name="ZoneDepot" MinHeight="88">
          <Rectangle x:Name="ZoneCadre" RadiusX="12" RadiusY="12" Stroke="#93C5FD" StrokeThickness="1.5"
                     StrokeDashArray="5 3" Fill="#F5F9FF"/>
          <Grid Margin="20,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource P100}" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Ico}" FontSize="20" Text="&#xE8B7;" Foreground="{StaticResource P600}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,12,0">
              <TextBlock x:Name="TxtZone" Text="§Glissez ici des PDF ou un dossier§" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource P900}"/>
              <TextBlock Text="§Ils s'ajoutent à la liste. L'ordre de la liste est l'ordre de la fusion.§" Foreground="{StaticResource G500}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
              <!-- Texte dans un TextBlock : en Content direct, un « _ » serait pris pour une touche d'accès. -->
              <CheckBox x:Name="ChkSousDossiers" Margin="0,6,0,0" VerticalContentAlignment="Center" Foreground="{StaticResource G700}"
                        ToolTip="§Prend aussi les PDF des sous-dossiers, dans l'ordre de l'Explorateur : les sous-dossiers d'abord, puis les PDF du dossier. Le choix est mémorisé.§">
                <TextBlock Text="§Inclure les sous-dossiers§" FontSize="12.5"/>
              </CheckBox>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BtnDossier" Style="{StaticResource BtnPrim}" ToolTip="§Ajouter tous les PDF d'un dossier§">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Ico}" Text="&#xE838;"/>
                  <TextBlock Text="§Choisir un dossier§" Margin="7,0,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnFichiers" Style="{StaticResource BtnContour}" Margin="8,0,0,0" Padding="12,7" ToolTip="§Ajouter un ou plusieurs PDF§">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Ico}" Text="&#xE710;"/>
                  <TextBlock Text="§Ajouter des fichiers§" Margin="7,0,0,0"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Grid>

        <!-- Barre d'outils -->
        <WrapPanel x:Name="BarreOutils" Grid.Row="1" Margin="0,14,0,10">
          <Button x:Name="BtnMonter" Style="{StaticResource BtnSec}" ToolTip="§Monter la sélection (Alt+Haut)§">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Ico}" Text="&#xE70E;"/><TextBlock Text="§Monter§" Margin="6,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="BtnDescendre" Style="{StaticResource BtnSec}" Margin="6,0,0,0" ToolTip="§Descendre la sélection (Alt+Bas)§">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Ico}" Text="&#xE70D;"/><TextBlock Text="§Descendre§" Margin="6,0,0,0"/></StackPanel>
          </Button>
          <Border Width="1" Height="22" Background="{StaticResource G200}" Margin="10,0"/>
          <Button x:Name="BtnTriNom" Style="{StaticResource BtnSec}" ToolTip="§Tri naturel : page9 avant page10§">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Ico}" Text="&#xE8CB;"/><TextBlock Text="§Trier par nom§" Margin="6,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="BtnTriDate" Style="{StaticResource BtnSec}" Margin="6,0,0,0" ToolTip="§Du plus ancien au plus récent§">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Ico}" Text="&#xE787;"/><TextBlock Text="§Trier par date§" Margin="6,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="BtnInverser" Style="{StaticResource BtnSec}" Margin="6,0,0,0" ToolTip="§Inverser l'ordre de la liste§">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Ico}" Text="&#xE8AB;"/><TextBlock Text="§Inverser§" Margin="6,0,0,0"/></StackPanel>
          </Button>
          <Border Width="1" Height="22" Background="{StaticResource G200}" Margin="10,0"/>
          <Button x:Name="BtnRetirer" Style="{StaticResource BtnSec}" ToolTip="§Retirer la sélection de la liste (Suppr). Le fichier n'est pas supprimé.§">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Ico}" Text="&#xE74D;"/><TextBlock Text="§Retirer§" Margin="6,0,0,0"/></StackPanel>
          </Button>
        </WrapPanel>

        <!-- Liste -->
        <Border x:Name="CarteListe" Grid.Row="2" Background="White" BorderBrush="{StaticResource G200}" BorderThickness="1" CornerRadius="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="14,10,32,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="84"/>
                <ColumnDefinition Width="72"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="#" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="2" Text="§FICHIER§" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="3" Text="PAGES" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="4" Text="§TAILLE§" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            </Grid>
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{StaticResource G200}"/>

            <ListBox x:Name="Liste" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionMode="Extended"
                     ItemContainerStyle="{StaticResource Ligne}" ItemTemplate="{StaticResource ModeleLigne}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"/>

            <StackPanel x:Name="ListeVide" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
              <TextBlock Style="{StaticResource Ico}" FontSize="34" Text="&#xE8A5;" Foreground="#D1D5DB" HorizontalAlignment="Center"/>
              <TextBlock Text="§Aucun fichier pour l'instant§" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource G700}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
              <TextBlock Text="§Glissez des PDF dans la fenêtre, ou cliquez sur «&#160;Choisir un dossier&#160;».§" Foreground="{StaticResource G500}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="{StaticResource G100}" BorderThickness="0,1,0,0" Padding="16,8">
              <Grid>
                <TextBlock x:Name="TxtResume" Foreground="{StaticResource G500}" FontSize="12"/>
                <TextBlock Foreground="#9CA3AF" FontSize="12" HorizontalAlignment="Right"
                           Text="§Glisser une ligne pour la déplacer · Ctrl ou Maj pour en choisir plusieurs§"/>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <!-- Aperçu -->
      <Border x:Name="CarteApercu" Grid.Column="2" Background="White" BorderBrush="{StaticResource G200}" BorderThickness="1" CornerRadius="12" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="§APERÇU · PREMIÈRE PAGE§" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold"/>
          <Border Grid.Row="1" Background="{StaticResource G100}" CornerRadius="8" Margin="0,10,0,12">
            <Grid>
              <Border x:Name="CadrePage" Background="White" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.16" Direction="270"/>
                </Border.Effect>
                <Image x:Name="ImgApercu" Stretch="Uniform"/>
              </Border>
              <StackPanel x:Name="ApercuVide" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <TextBlock x:Name="IcoApercu" Style="{StaticResource Ico}" FontSize="28" Text="&#xE8A5;" Foreground="#D1D5DB" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtApercuVide" Text="§Sélectionnez un fichier pour voir sa première page.§"
                           Foreground="{StaticResource G500}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
          <StackPanel Grid.Row="2">
            <TextBlock x:Name="TxtApercuNom" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource G900}"/>
            <TextBlock x:Name="TxtApercuInfo" Foreground="{StaticResource G500}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ============ Bandeau (succès, erreur, information) ============ -->
    <Border x:Name="Bandeau" Grid.Row="2" Margin="24,0,24,14" CornerRadius="10" BorderThickness="1" Padding="16,12" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="BandeauIcone" Style="{StaticResource Ico}" FontSize="20" VerticalAlignment="Top" Margin="0,1,14,0"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="BandeauTitre" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap"/>
          <TextBlock x:Name="BandeauTexte" TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button x:Name="BtnOuvrirPdf" Style="{StaticResource BtnPrim}">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Ico}" Text="&#xE8E5;"/><TextBlock Text="§Ouvrir le PDF§" Margin="7,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="BtnOuvrirDossier" Style="{StaticResource BtnSec}" Margin="8,0,0,0" Padding="12,7">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Ico}" Text="&#xE838;"/><TextBlock Text="§Ouvrir le dossier§" Margin="7,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="BtnPortail" Style="{StaticResource BtnSec}" Margin="8,0,0,0" Padding="12,7">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Ico}" Text="&#xE719;"/><TextBlock Text="§Ouvrir le Portail d'entreprise§" Margin="7,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="BtnFermerBandeau" Style="{StaticResource BtnDiscret}" Margin="8,0,0,0" ToolTip="§Fermer§">
            <TextBlock Style="{StaticResource Ico}" FontSize="11" Text="&#xE711;"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ Pied : options, progression, Fusionner ============ -->
    <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource G200}" BorderThickness="0,1,0,0" Padding="24,16,24,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="Options" Margin="0,0,24,0">
          <Grid MaxWidth="760" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="§Fichier de sortie§" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource G700}"/>
            <!-- Le nom est OBLIGATOIRE (demande du 21/10) : l'utilisateur tape la
                 partie avant « _FUSION_<date>.pdf », qui est fixe et affichée à côté. -->
            <Grid Grid.Column="1" HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TxtSortie" Style="{StaticResource Champ}" Width="260"
                       ToolTip="§Obligatoire : le nom du document, par exemple « Dossier Dupont ».§"/>
              <TextBlock x:Name="TxtNomVide" Text="§Nom du document (obligatoire)§" IsHitTestVisible="False"
                         VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#9CA3AF" FontStyle="Italic"/>
              <TextBlock x:Name="TxtSuffixeSortie" Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0"
                         Foreground="{StaticResource G500}" FontFamily="Consolas" FontSize="12.5"
                         ToolTip="§Ajouté automatiquement : marque le fichier comme une fusion, avec la date.§"/>
            </Grid>
            <Button x:Name="BtnEnregistrerSous" Grid.Column="2" Style="{StaticResource BtnSec}" Margin="8,0,0,0" Padding="11,7" ToolTip="§Choisir le dossier et le nom du fichier fusionné§">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Ico}" Text="&#xE74E;"/><TextBlock Text="§Enregistrer sous…§" Margin="6,0,0,0"/></StackPanel>
            </Button>
          </Grid>
          <TextBlock x:Name="TxtDossierSortie" Foreground="{StaticResource G500}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
          <!-- Texte dans un TextBlock : en Content direct, «&#160;_&#160;» serait pris pour une touche d'accès et disparaîtrait. -->
          <CheckBox x:Name="ChkRenommer" Margin="0,12,0,0" VerticalContentAlignment="Center" Foreground="{StaticResource G700}">
            <TextBlock Text="§Renommer aussi les fichiers sources avec 001_, 002_… dans l'ordre de la liste§"/>
          </CheckBox>
          <TextBlock Margin="21,3,0,0" FontSize="12" Foreground="{StaticResource G500}" TextWrapping="Wrap">
            <Run Text="§Utile seulement si l'ordre doit rester visible dans SharePoint. Réversible : les anciens noms sont gardés dans un fichier _RENOMMAGE_&lt;date&gt;.csv.§"/>
            <Hyperlink x:Name="LienAnnuler">§Annuler un renommage…§</Hyperlink>
          </TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <Button x:Name="BtnFusionner" Style="{StaticResource BtnPrim}" Padding="30,12" FontSize="15" MinWidth="210">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Ico}" FontSize="15" Text="&#xE8A5;"/>
              <TextBlock Text="§Fusionner§" Margin="9,0,0,1"/>
            </StackPanel>
          </Button>
          <TextBlock x:Name="TxtAideFusion" Foreground="{StaticResource G500}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          <!-- Version, lue dans l'exe par le code : ne peut pas diverger de la version réelle. -->
          <TextBlock x:Name="TxtVersion" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Right" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel x:Name="ZoneProgres" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" Visibility="Collapsed">
          <Grid Margin="0,0,0,6">
            <TextBlock x:Name="TxtProgres" Foreground="{StaticResource G700}" TextTrimming="CharacterEllipsis" Margin="0,0,60,0"/>
            <TextBlock x:Name="TxtPourcent" Foreground="{StaticResource P600}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
          </Grid>
          <ProgressBar x:Name="Progres" Style="{StaticResource Barre}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ Aide : panneau latéral, par-dessus tout ============ -->
    <Grid x:Name="Aide" Grid.RowSpan="4" Visibility="Collapsed">
      <Border x:Name="AideFond" Background="#73111827"/>
      <Border x:Name="AidePanneau" Width="470" HorizontalAlignment="Right" Background="White"
              BorderBrush="{StaticResource G200}" BorderThickness="1,0,0,0">
        <Border.Effect>
          <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.22"/>
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border BorderBrush="{StaticResource G200}" BorderThickness="0,0,0,1" Padding="24,18,16,16">
            <Grid>
              <StackPanel>
                <TextBlock Text="§Comment utiliser Fusion PDF§" FontSize="17" FontWeight="Bold" Foreground="{StaticResource G900}"/>
                <TextBlock Text="§Tout tient en trois gestes. Rien n'est modifié dans vos fichiers d'origine.§" Foreground="{StaticResource G500}" Margin="0,3,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <Button x:Name="BtnFermerAide" Style="{StaticResource BtnDiscret}" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="§Fermer (Échap)§">
                <TextBlock Style="{StaticResource Ico}" FontSize="12" Text="&#xE711;"/>
              </Button>
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,6,24,16">
            <StackPanel>
              <StackPanel.Resources>
                <Style x:Key="Titre" TargetType="TextBlock">
                  <Setter Property="FontSize" Value="13.5"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                  <Setter Property="Foreground" Value="#1E3A5F"/>
                  <Setter Property="Margin" Value="0,18,0,8"/>
                </Style>
                <Style x:Key="Texte" TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap"/>
                  <Setter Property="Foreground" Value="#374151"/>
                  <Setter Property="Margin" Value="0,0,0,6"/>
                  <Setter Property="LineHeight" Value="19"/>
                </Style>
                <Style x:Key="Num" TargetType="Border">
                  <Setter Property="Width" Value="22"/>
                  <Setter Property="Height" Value="22"/>
                  <Setter Property="CornerRadius" Value="11"/>
                  <Setter Property="Background" Value="#DBEAFE"/>
                  <Setter Property="VerticalAlignment" Value="Top"/>
                  <Setter Property="Margin" Value="0,0,10,0"/>
                </Style>
                <Style x:Key="NumTxt" TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Center"/>
                  <Setter Property="VerticalAlignment" Value="Center"/>
                  <Setter Property="FontSize" Value="11.5"/>
                  <Setter Property="FontWeight" Value="Bold"/>
                  <Setter Property="Foreground" Value="#1D4ED8"/>
                </Style>
              </StackPanel.Resources>

              <TextBlock Style="{StaticResource Titre}" Text="§Fusionner en trois gestes§"/>
              <DockPanel Margin="0,0,0,8">
                <Border Style="{StaticResource Num}"><TextBlock Style="{StaticResource NumTxt}" Text="1"/></Border>
                <TextBlock Style="{StaticResource Texte}">§<Bold>Ajoutez les PDF</Bold> : glissez-les dans la fenêtre, avec un dossier entier si vous voulez, ou cliquez sur «&#160;Choisir un dossier&#160;».§</TextBlock>
              </DockPanel>
              <DockPanel Margin="0,0,0,8">
                <Border Style="{StaticResource Num}"><TextBlock Style="{StaticResource NumTxt}" Text="2"/></Border>
                <TextBlock Style="{StaticResource Texte}">§<Bold>Vérifiez l'ordre</Bold> : l'ordre de la liste est l'ordre du fichier final. Cliquez sur une ligne pour voir sa première page à droite.§</TextBlock>
              </DockPanel>
              <DockPanel>
                <Border Style="{StaticResource Num}"><TextBlock Style="{StaticResource NumTxt}" Text="3"/></Border>
                <TextBlock Style="{StaticResource Texte}">§<Bold>Nommez le fichier, puis cliquez sur Fusionner</Bold>. Le nom est obligatoire : tapez-le dans la case «&#160;Fichier de sortie&#160;», par exemple «&#160;Dossier Dupont&#160;». Le fichier Dossier Dupont_FUSION_&lt;date&gt;.pdf apparaît dans le dossier des fichiers, avec les boutons «&#160;Ouvrir le PDF&#160;» et «&#160;Ouvrir le dossier&#160;».§</TextBlock>
              </DockPanel>

              <TextBlock Style="{StaticResource Titre}" Text="§Depuis l'Explorateur, sans ouvrir l'application§"/>
              <TextBlock Style="{StaticResource Texte}">§Clic droit sur un dossier, puis <Bold>«&#160;Afficher d'autres options&#160;»</Bold> et <Bold>«&#160;Fusionner les PDF de ce dossier&#160;»</Bold>. Fusion PDF s'ouvre avec tous les PDF du dossier, déjà triés. Pour toute l'arborescence, choisissez <Bold>«&#160;Fusionner les PDF de ce dossier et de ses sous-dossiers&#160;»</Bold>.§</TextBlock>
              <TextBlock Style="{StaticResource Texte}" Foreground="#6B7280">§Raccourci : Maj + clic droit affiche directement la commande. Pour prendre aussi les PDF des sous-dossiers, cochez <Bold>«&#160;Inclure les sous-dossiers&#160;»</Bold> : l'ordre est celui de l'Explorateur, les sous-dossiers d'abord, puis les PDF du dossier.§</TextBlock>

              <TextBlock Style="{StaticResource Titre}" Text="§Changer l'ordre§"/>
              <TextBlock Style="{StaticResource Texte}">§• <Bold>Glissez une ligne</Bold> à sa place : un trait bleu montre où elle va. Ctrl ou Maj pour en déplacer plusieurs.§</TextBlock>
              <TextBlock Style="{StaticResource Texte}">§• <Bold>Monter</Bold> et <Bold>Descendre</Bold> (Alt + flèches) déplacent la sélection d'un cran.§</TextBlock>
              <TextBlock Style="{StaticResource Texte}">§• <Bold>Trier par nom</Bold> range «&#160;page9&#160;» avant «&#160;page10&#160;», comme l'Explorateur : inutile de numéroter vos fichiers.§</TextBlock>
              <TextBlock Style="{StaticResource Texte}">§• <Bold>Retirer</Bold> (Suppr) enlève la ligne de la liste, sans supprimer le fichier.§</TextBlock>

              <TextBlock Style="{StaticResource Titre}" Text="§Renommer les fichiers 001_, 002_…§"/>
              <TextBlock Style="{StaticResource Texte}">§Seulement si l'ordre doit rester visible pour d'autres, dans SharePoint par exemple. Les anciens noms sont gardés dans un fichier _RENOMMAGE_&lt;date&gt;.csv : le lien <Bold>«&#160;Annuler un renommage…&#160;»</Bold> les rétablit.§</TextBlock>

              <TextBlock Style="{StaticResource Titre}" Text="§Fichiers OneDrive «&#160;En ligne seulement&#160;»§"/>
              <TextBlock Style="{StaticResource Texte}">§Rien à faire : ils sont téléchargés automatiquement au moment de la fusion. Il faut seulement être connecté à Internet.§</TextBlock>

              <TextBlock Style="{StaticResource Titre}" Text="§Si un message apparaît§"/>
              <TextBlock Style="{StaticResource Texte}">§• <Bold>Protégé par un mot de passe</Bold> : retirez le fichier, ou enregistrez-en une copie sans protection (Imprimer › Microsoft Print to PDF).§</TextBlock>
              <TextBlock Style="{StaticResource Texte}">§• <Bold>Ouvert dans un autre programme</Bold> : fermez-le dans votre lecteur PDF, puis relancez.§</TextBlock>
              <TextBlock Style="{StaticResource Texte}">§• <Bold>Endommagé ou illisible</Bold> : ouvrez-le pour vérifier, puis retirez-le de la liste.§</TextBlock>
              <TextBlock Style="{StaticResource Texte}">§• <Bold>qpdf n'est pas installé</Bold> : installez-le depuis le Portail d'entreprise, puis cliquez de nouveau sur Fusionner.§</TextBlock>
              <TextBlock Style="{StaticResource Titre}" Text="§Langue§"/>
              <TextBlock Style="{StaticResource Texte}">§Les boutons <Bold>FR</Bold> et <Bold>EN</Bold>, en haut à droite, changent la langue. Le choix est mémorisé, et la liste en cours est gardée.§</TextBlock>
              <TextBlock Style="{StaticResource Texte}" Foreground="#6B7280" Margin="0,10,0,0">§Un problème persiste ? Écrivez au support IT.§</TextBlock>
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Row="2" BorderBrush="{StaticResource G200}" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="BtnFaqPdf" Style="{StaticResource BtnSec}" Padding="12,7">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Ico}" Text="&#xE8A5;"/><TextBlock Text="§Ouvrir la FAQ complète (PDF)§" Margin="7,0,0,0"/></StackPanel>
              </Button>
              <Button x:Name="BtnCompris" Style="{StaticResource BtnPrim}" Margin="8,0,0,0" Padding="18,7" Content="§J'ai compris§"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
